-- Data Cleaning Done Right!

-- 1. Create new table so the raw table we can use as a comparasion
CREATE TABLE crime_cln
LIKE crime_incidents_messy;

INSERT crime_cln
SELECT *
FROM crime_incidents_messy;

-- 2. Remove duplicates
WITH duplicate_cte AS (
SELECT 
	*, 
	ROW_NUMBER() OVER (PARTITION BY incident_id) AS ROW_NUM
    FROM crime_cln
    )
    
SELECT *
FROM duplicate_cte
WHERE ROW_NUM > 1

ALTER TABLE crime_cln
ADD COLUMN row_id INT AUTO_INCREMENT PRIMARY KEY;

WITH duplicate_cte AS (
    SELECT
        row_id,
        ROW_NUMBER() OVER (
            PARTITION BY incident_id
            ORDER BY row_id
        ) AS ROW_NUM
    FROM crime_cln
)
DELETE c
FROM crime_cln AS c
JOIN duplicate_cte AS d
    ON c.row_id = d.row_id
WHERE d.ROW_NUM > 1;

