UPDATE crime_cln
SET district = 
	CASE 
    WHEN district LIKE 'cen%' THEN 'central'
    WHEN district LIKE 'eas%' THEN 'east'
    WHEN district LIKE 'mid%' THEN 'midtown'
    WHEN district = 'nor' THEN 'north'
    WHEN district = 'sou' THEN 'south'
    WHEN district LIKE 'we%' THEN 'west'
    ELSE district END;
    
UPDATE crime_cln
SET victim_gender = 
	CASE 
    WHEN victim_gender LIKE 'f%' THEN 'female'
    WHEN victim_gender LIKE 'm%' THEN 'male'
    WHEN victim_gender LIKE 'unk%' THEN 'other'
    WHEN victim_gender LIKE 'n/%' THEN NULL
    ELSE victim_gender END;

UPDATE crime_cln
SET suspect_gender = 
	CASE 
    WHEN suspect_gender LIKE 'f%' THEN 'female'
    WHEN suspect_gender LIKE 'm%' THEN 'male'
    WHEN suspect_gender LIKE 'unk%' THEN 'other'
    WHEN suspect_gender LIKE 'n/%' THEN NULL
    ELSE suspect_gender END;
    
UPDATE crime_cln
SET suspect_race = 
	CASE 
    WHEN suspect_race LIKE 'n/%' THEN NULL
    WHEN suspect_race LIKE 'unk%' THEN 'other'
    ELSE suspect_race END;
    
UPDATE crime_cln
SET severity = 
	CASE 
    WHEN severity = 1 THEN 'low'
    WHEN severity = 2 THEN 'medium'
    WHEN severity = 3 THEN 'high'
    WHEN severity = 4 THEN 'critical'
    WHEN severity LIKE 'cri%' THEN 'critical'
    WHEN severity LIKE 'med%' THEN 'medium'
    ELSE severity END;
    
UPDATE crime_cln
SET reported_online = 
	CASE 
    WHEN reported_online = 1 THEN 'true'
    WHEN reported_online = 0 THEN 'false'
    WHEN reported_online LIKE 'n%' THEN 'false'
    WHEN reported_online LIKE 'y%' THEN 'true'
    ELSE reported_online END;
    
